# Lean build artifacts
/build/
/lake-packages/
/.lake/
/.tools/
/.venv/
# Build verification only; LaTeX source is the deliverable.
*.pdf

# LaTeX auxiliary files
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.synctex.gz
*.fls
*.fdb_latexmk

# Python cache
__pycache__/
*.pyc
*.pyo

# Temporary files
*.swp
*.swo
*~
.DS_Store

# Search results
*_search*.json

# Large data dumps
*.h5
*.hdf5
# Derived caches (regenerable: the FCI matrix is rebuilt by the script and
# re-validated against fci.FCI; do not commit binaries)
*.npy
experiments/complement/*.partial.json
